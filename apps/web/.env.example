# Signaling Server (WebRTC Omegle Mode)
VITE_SIGNALING_URL=

# Supabase — Required (anon key is designed to be public; RLS enforces auth)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Deepgram Speech-to-Text
# CLIENT: No key needed — /.netlify/functions/deepgram-token vends short-lived keys (10s TTL)
# SERVER (Netlify env vars, never prefixed VITE_):
#   DEEPGRAM_API_KEY=<your master key>
#   ALLOWED_ORIGINS=https://your-app.netlify.app
#   FIREBASE_WEB_API_KEY=<same as VITE_FIREBASE_API_KEY, used server-side for token lookup>

# YouTube Data API v3 (public read-only key — restrict by HTTP referer in GCP console)
VITE_YOUTUBE_API_KEY=

# Twitch API
# CLIENT: Public client ID (sent in Client-ID header per Twitch spec)
VITE_TWITCH_CLIENT_ID=
# SERVER (Netlify env vars, never prefixed VITE_):
#   TWITCH_CLIENT_ID=<same value>
#   TWITCH_CLIENT_SECRET=<your secret>

# Kick API (client_secret is server-only)
VITE_KICK_CLIENT_ID=
# SERVER: KICK_CLIENT_SECRET=<your secret>

# Firebase — Required (Firebase config is designed to be public; Firestore rules enforce auth)
# Get from https://console.firebase.google.com/ -> Project Settings -> General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Service URLs & OAuth Client IDs
VITE_HANDOFF_API_URL=
VITE_MLSHARP_API_URL=
VITE_YOUTUBE_CLIENT_ID=

# AI & Media Stock APIs (public/client keys — consider proxying if private)
VITE_PUBLIC_AI_KEY=
VITE_GEMINI_API_KEY=
VITE_PEXELS_API_KEY=
VITE_PIXABAY_API_KEY=
VITE_GIPHY_API_KEY=
