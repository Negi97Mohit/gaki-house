{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/dist/**",
    "**/release/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js"
  ],
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/main.tsx!",
        "netlify/functions/*.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!", "netlify/functions/*.ts!"]
    },
    "apps/gaki-mobile": {
      "entry": ["src/main.tsx!"],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "apps/desktop": {
      "entry": ["electron/main.ts!", "electron/preload.ts!"],
      "project": ["electron/**/*.ts!"]
    },
    "apps/api-handoff": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "apps/api-signaling": {
      "entry": ["index.js!", "signaling-server.js!"],
      "project": ["*.js!"]
    },
    "packages/*": {
      "entry": ["src/**/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}!"]
    }
  }
}
